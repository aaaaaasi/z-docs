// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id @default(cuid())
  title     String   @default("Untitled document")
  content   String   @default("")
  starred   Boolean  @default(false)
  trashed   Boolean  @default(false)
  /// optional folder grouping (null = home root)
  folderId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocumentVersion[]
  comments Comment[]
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

/// Named folders for organizing documents in the home view.
model Folder {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#0b6b62")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@unique([name])
}

model DocumentVersion {
  id        String   @id @default(cuid())
  docId     String
  title     String
  content   String
  createdAt DateTime @default(now())

  doc Document @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
}

/// Threaded comments anchored to quoted text inside a document.
model Comment {
  id          String   @id @default(cuid())
  docId       String
  /// null for top-level comments, parent Comment id for replies
  parentId    String?
  /// author profile snapshot (local identity: id / name / color)
  authorId    String
  authorName  String
  authorColor String
  /// quoted document text the comment is anchored to ("" when unanchored)
  quote       String   @default("")
  /// character offset of the quote inside the document text at creation time
  anchorOffset Int     @default(0)
  content     String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doc         Document          @relation(fields: [docId], references: [id], onDelete: Cascade)
  parent      Comment?          @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]         @relation("CommentThread")
  reactions   CommentReaction[]

  @@index([docId, createdAt])
}

/// emoji reaction on a comment (one per user+emoji; toggle = delete)
model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  userName  String
  /// the emoji character itself (e.g. "👍")
  emoji     String
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}
