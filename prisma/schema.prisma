// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id @default(cuid())
  title     String   @default("Untitled document")
  content   String   @default("")
  starred   Boolean  @default(false)
  trashed   Boolean  @default(false)
  /// optional folder grouping (null = home root)
  folderId  String?
  /// owner account (null = orphaned legacy doc, invisible to every user)
  ownerId   String?
  /// Ellipsus-style writing telemetry: WritingStats JSON blob (client-merged)
  stats     String   @default("")
  /// number of saved content changes after the first version (server-managed)
  editCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocumentVersion[]
  comments Comment[]
  tags     DocumentTag[]
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  collaborators Collaborator[]
}

/// A member account of the Z-Docs workspace (credentials auth).
/// Every user is fully independent — no admin, no shared workspace data.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// scrypt hash: "salt:hex" — never the raw password
  passwordHash String
  /// display color used for presence/comments
  color        String   @default("#0e7c74")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     UserSession[]
}

/// Server-side session tokens (random 32 bytes) issued as an httpOnly cookie.
model UserSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Named folders for organizing documents in the home view (per user).
model Folder {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#0b6b62")
  /// owner account (null = legacy folder, hidden)
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
}

/// Colored labels (Google Drive style) attached to documents (per user).
model Tag {
  id        String        @id @default(cuid())
  name      String
  color     String        @default("#0b6b62")
  /// owner account (null = legacy tag, hidden)
  ownerId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  documents DocumentTag[]
}

/// Join table: which documents carry which tags.
model DocumentTag {
  docId String
  tagId String

  doc Document @relation(fields: [docId], references: [id], onDelete: Cascade)
  tag Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([docId, tagId])
  @@index([docId])
  @@index([tagId])
}

/// Z-Sheets: a spreadsheet with cells stored as a JSON blob.
model Sheet {
  id        String   @id @default(cuid())
  title     String   @default("Untitled spreadsheet")
  /// JSON of SheetData { rows, cols, cells: Record<"A1", CellData> }
  data      String   @default("{}")
  starred   Boolean  @default(false)
  trashed   Boolean  @default(false)
  /// owner account (null = orphaned legacy entity, invisible)
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Z-Slides: a presentation deck stored as a JSON blob.
model SlideDeck {
  id        String   @id @default(cuid())
  title     String   @default("Untitled presentation")
  /// JSON of DeckData { slides: Slide[], theme: { accent, font } }
  data      String   @default("[]")
  starred   Boolean  @default(false)
  trashed   Boolean  @default(false)
  /// owner account (null = orphaned legacy entity, invisible)
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Z-Forms: a form with questions stored as a JSON blob.
model Form {
  id          String   @id @default(cuid())
  title       String   @default("Untitled form")
  description String   @default("")
  /// JSON of Question[]
  data        String   @default("[]")
  starred     Boolean  @default(false)
  trashed     Boolean  @default(false)
  /// owner account (null = orphaned legacy entity, invisible)
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses   FormResponse[]
}

/// A single submitted response to a Form.
model FormResponse {
  id          String   @id @default(cuid())
  formId      String
  /// JSON of answers Record<questionId, string | string[] | number>
  answers     String   @default("{}")
  submittedAt DateTime @default(now())

  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, submittedAt])
}

/// Cross-app recent activity feed (Google Drive activity style).
model ActivityLog {
  id          String   @id @default(cuid())
  /// "docs" | "sheets" | "slides" | "forms"
  app         String
  /// created | edited | renamed | starred | unstarred | trashed | restored | duplicated | commented | submitted
  kind        String
  /// id of the touched entity ("" when not applicable)
  entityId    String
  /// display title of the entity
  entityTitle String
  /// extra human line, e.g. "renamed to “X”" or "2 replies"
  detail      String   @default("")
  actorId     String
  actorName   String
  actorColor  String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// People a document is shared with (email invite, local demo).
model Collaborator {
  id        String   @id @default(cuid())
  docId     String
  email     String
  name      String   @default("")
  color     String   @default("#0b6b62")
  /// "viewer" | "editor"
  role      String   @default("viewer")
  createdAt DateTime @default(now())

  doc       Document @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, email])
  @@index([docId])
}

model DocumentVersion {
  id        String   @id @default(cuid())
  docId     String
  title     String
  content   String
  createdAt DateTime @default(now())

  doc Document @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
}

/// Threaded comments anchored to quoted text inside a document.
model Comment {
  id          String   @id @default(cuid())
  docId       String
  /// null for top-level comments, parent Comment id for replies
  parentId    String?
  /// author profile snapshot (local identity: id / name / color)
  authorId    String
  authorName  String
  authorColor String
  /// quoted document text the comment is anchored to ("" when unanchored)
  quote       String   @default("")
  /// character offset of the quote inside the document text at creation time
  anchorOffset Int     @default(0)
  content     String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doc         Document          @relation(fields: [docId], references: [id], onDelete: Cascade)
  parent      Comment?          @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]         @relation("CommentThread")
  reactions   CommentReaction[]

  @@index([docId, createdAt])
}

/// emoji reaction on a comment (one per user+emoji; toggle = delete)
model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  userName  String
  /// the emoji character itself (e.g. "👍")
  emoji     String
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}
